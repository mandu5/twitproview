# OpenAI API Configuration (Optional - for AI-generated tweet content)
# Get your API key from: https://platform.openai.com/api-keys
# If not set, the application will use fallback template-based generation
OPENAI_API_KEY=your_openai_api_key_here

# Twitter API Configuration (Optional - only needed for Trends feature)
# Get your credentials from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_CONSUMER_API_KEY=your_twitter_consumer_api_key_here
TWITTER_CONSUMER_API_SECRET=your_twitter_consumer_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# Server Configuration
PORT=3000
